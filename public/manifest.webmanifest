{
  "name": "SideQuest ATX",
  "short_name": "SideQuest",
  "description": "Austin's live map of broken, blocked and missing sidewalks, each tracked until it is fixed.",
  "id": "/app",
  "start_url": "/map",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ece6d6",
  "theme_color": "#37412a",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Live map", "url": "/map", "description": "Every reported sidewalk hazard in Austin" },
    { "name": "Open data", "url": "/data", "description": "Download the reports as CSV or GeoJSON" }
  ]
}
