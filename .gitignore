node_modules
dist
*.local
.env
.env.local
.DS_Store
*.log
.vercel
.env*

# Render pipeline: multi-GB assets, caches, frames and the scene file stay local
# (scripts, world.json and out/REPORT.md are tracked)
render/assets/
render/cache/
render/out/*
!render/out/REPORT.md
render/street.blend
render/gis/.venv/
render/gis/_sources/
render/gis/_logs/
render/gis/downtown/
render/gis/anderson_mill/
# Stock aerial clips trialled and dropped (opt-in ?film=1 only)
public/prologue/
render/*.blend*
# Runway pipeline: source photos (GPS in EXIF) and takes stay local;
# only published clips in public/media/runway are tracked
runway/photos/*
!runway/photos/.gitkeep
runway/work/
__pycache__/
*.pyc
